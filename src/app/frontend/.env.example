# URL del backend FastAPI. El frontend la lee de VITE_API_URL (nunca va en el código).
# Si no se define, se usa http://localhost:8080 (uvicorn local por defecto).
VITE_API_URL=http://localhost:8080

# URL del videojuego (app Vite aparte, no se fusiona con este frontend).
# En local: http://localhost:3000
# En AWS con CloudFront bajo el mismo dominio: /juego/
VITE_GAME_URL=http://localhost:3000

# URL de estilo vectorial compatible con MapLibre (opcional)
VITE_MAP_STYLE_URL=

# API key de MapTiler (opcional, si se usa su estilo vectorial oscuro)
VITE_MAPTILER_KEY=
VITE_MAPTILER_API_KEY=
VITE_MAPTILER_TOKEN=
